+.watch-trends { margin-top: 22px; padding: 2px 0 20px; border-bottom: 1px solid #2a5650; min-width: 0; }
+.trend-scope, .trend-help, .trend-context { color: #c9d9ce; font-size: .88rem; line-height: 1.6; }
