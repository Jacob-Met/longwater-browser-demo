+.trend-values { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0; }
+.trend-values dt { color: #a8c1b4; font-size: .8rem; overflow-wrap: anywhere; }
+.trend-values dd { margin: 4px 0 0; color: #e6f0e5; font-size: 1.1rem; font-variant-numeric: tabular-nums; }
+.trend-table-details { font-size: .88rem; }
+.trend-table-details summary { color: #72e2b4; }
+#trend-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: .82rem; font-variant-numeric: tabular-nums; }
+#trend-table caption { padding: 10px 0; text-align: left; color: #c9d9ce; }
+#trend-table :is(th, td) { padding: 8px 6px; border-bottom: 1px solid #2a5650; text-align: right; overflow-wrap: anywhere; }
+#trend-table th { color: #c9d9ce; font-weight: 600; }
+#trend-table th:first-child { text-align: left; }
+@media (max-width: 520px) {
+  .trend-controls { grid-template-columns: 1fr; gap: 12px; }
+  .trend-legend { gap: 8px 14px; }
+  .trend-readout { padding: 12px 10px; }
+  .trend-values { gap: 8px; }
+  .trend-values dd { font-size: 1rem; }
+}
