+.trend-controls label { display: block; min-width: 0; color: #e6f0e5; font-size: .88rem; }
+.trend-controls select { display: block; width: 100%; min-height: 44px; margin-top: 6px; padding: 8px 10px; border: 1px solid #64897e; border-radius: 8px; background: #123238; color: #e6f0e5; font: inherit; }
+.trend-controls input { display: block; width: 100%; height: 44px; margin: 6px 0 0; accent-color: #72e2b4; cursor: pointer; }
+.trend-controls :is(select, input):focus-visible { outline: 3px solid #e6f0e5; outline-offset: 3px; }
+.trend-legend { display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; padding: 0; margin: 14px 0 8px; font-size: .82rem; }
