        "before": "import { SavedWatch, WATCH_SAVE_KEY, MAX_SAVE_LENGTH } from \"./watch-save.js\";\n",
        "after": "import { SavedWatch, WATCH_SAVE_KEY, MAX_SAVE_LENGTH } from \"./watch-save.js\";\nimport { WatchChoice } from \"./watch-choice.js\";\n"
