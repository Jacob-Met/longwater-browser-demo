  "narrow_native_diff": "diff --git a/README.md b/README.md\nindex 0dc34c3..1f56f27 100644\n--- a/README.md\n+++ b/README.md\n@@ -18,6 +18,13 @@ reed canopy (Shade 0–3). Each tide, pick a cell and take one action:\n Every action is resolved against the live Rust simulation compiled to\n WebAssembly. Survive all fourteen tides to close the watch.\n \n+## Optional sound\n+\n+Switch **Sound cues** on below the marsh to hear quiet, original synthesized tones. Gate falls like a ripple, Shade uses a low pair of notes, and Seed rises in three short notes. A closing chord marks the actual end of the fourteen-tide watch. Sound adds feedback to the existing reports; it does not change the simulation or saved progress.\n+\n+Each page opens silently. The switch gives a short confirmation tone when sound is ready. Switching it off, hiding the page, or leaving the page stops sound and releases its audio context; returning stays silent until you enable it again. Unsupported or blocked audio leaves the game playable and displays an unavailable message. Interrupted audio can be enabled again with the switch. All tones are generated locally and included in the offline game, with no audio files, external requests or new dependency.\n+\n+\n ## Controls\n \n - **Mouse / touch** — tap a cell card to select it, tap an action button to act,\ndiff --git a/index.html b/index.html\nindex 5e7d5c7..62c226f 100644\n--- a/index.html\n+++ b/index.html\n@@ -12,6 +12,7 @@\n   <link rel=\"stylesheet\" href=\"./watch-report.css\">\n   <link rel=\"stylesheet\" href=\"./watch-trends.css\">\n   <link rel=\"stylesheet\" href=\"./watch-save.css\">\n+  <link rel=\"stylesheet\" href=\"./watch-audio.css\">\n </head>\n <body>\n   <main id=\"stage\" aria-labelledby=\"game-title\">\n@@ -30,6 +31,11 @@\n       </div>\n       <p id=\"startup-error\" hidden></p>\n     </div>\n+    <section class=\"watch-audio\" aria-label=\"Sound\">\n+      <label><input id=\"sound-enabled\" type=\"checkbox\" role=\"switch\" aria-describedby=\"sound-note sound-status\" disabled> Sound cues</label>\n+      <span id=\"sound-status\" role=\"status\">Off</span>\n+      <p id=\"sound-note\">Quiet tones for your actions and the closing tide.</p>\n+    </section>\n     <section id=\"watch-storage\" aria-label=\"Watch progress\">\n       <p id=\"watch-save-status\" role=\"status\" aria-live=\"polite\">Loading your saved watch…</p>\n       <button id=\"watch-save-retry\" type=\"button\" hidden>Try saving again</button>\ndiff --git a/scripts/package.mjs b/scripts/package.mjs\nindex a936acf..5c0109e 100644\n--- a/scripts/package.mjs\n+++ b/scripts/package.mjs\n@@ -4,8 +4,8 @@ import { dirname, resolve } from \"node:path\";\n import { fileURLToPath } from \"node:url\";\n \n const root = resolve(dirname(fileURLToPath(import.meta.url)), \"..\");\n-const styles = [\"style.css\", \"journal.css\", \"watch-trends.css\", \"watch-save.css\", \"watch-report.css\"];\n-const modules = [\"pkg/longwater_web.js\", \"journal.js\", \"watch-save.js\"];\n+const styles = [\"style.css\", \"journal.css\", \"watch-trends.css\", \"watch-save.css\", \"watch-report.css\", \"watch-audio.css\"];\n+const modules = [\"pkg/longwater_web.js\", \"journal.js\", \"watch-save.js\", \"watch-audio.js\"];\n const inputs = [\"index.html\", ...styles, \"game.js\", ...modules, \"watch-trends.js\", \"watch-report.js\", \"pkg/longwater_web_bg.wasm\"];\n const sourceHash = createHash(\"sha256\");\n const files = new Map();\ndiff --git a/tests/watch-save.browser.test.mjs b/tests/watch-save.browser.test.mjs\nindex d78f9eb..1091efc 100644\n--- a/tests/watch-save.browser.test.mjs\n+++ b/tests/watch-save.browser.test.mjs\n@@ -14,6 +14,8 @@ const files = new Map([\n   [\"/game.js\", [\"game.js\", \"text/javascript\"]],\n   [\"/watch-save.js\", [\"watch-save.js\", \"text/javascript\"]],\n   [\"/watch-save.css\", [\"watch-save.css\", \"text/css\"]],\n+  [\"/watch-audio.js\", [\"watch-audio.js\", \"text/javascript\"]],\n+  [\"/watch-audio.css\", [\"watch-audio.css\", \"text/css\"]],\n   [\"/journal.js\", [\"journal.js\", \"text/javascript\"]],\n   [\"/journal.css\", [\"journal.css\", \"text/css\"]],\n   [\"/watch-trends.js\", [\"watch-trends.js\", \"text/javascript\"]],\n",
