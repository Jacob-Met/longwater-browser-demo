import datetime,hashlib,json,os,re,signal,subprocess,sys,time
from pathlib import Path
root=Path(__file__).resolve().parent
source=root/'source'
freeze_path=root/'candidate-source.json'
freeze=json.loads(freeze_path.read_text())
manifest_path=root/'candidate-source-manifest.json'
assert hashlib.sha256(manifest_path.read_bytes()).hexdigest()==freeze['manifest_sha256']
manifest=json.loads(manifest_path.read_text())
run=root/'full-current-suite'
run.mkdir(exist_ok=False)
(run/'tmp').mkdir()
def verify():
 errors=[]
 for item in manifest:
  p=source/item['path']
  if not p.is_file() or p.is_symlink():errors.append(item['path']+': not regular');continue
  b=p.read_bytes()
  if len(b)!=item['bytes'] or hashlib.sha256(b).hexdigest()!=item['sha256']:errors.append(item['path']+': bytes differ')
  if ('100755' if p.stat().st_mode&0o111 else '100644')!=item['mode']:errors.append(item['path']+': mode differs')
 head=subprocess.check_output(['git','--no-optional-locks','-C',str(source),'rev-parse','HEAD'],text=True).strip()
 if head!=freeze['head']:errors.append('HEAD differs')
 status=subprocess.check_output(['git','--no-optional-locks','-C',str(source),'status','--porcelain'],text=True)
 if status:errors.append('worktree dirty: '+status)
 return errors
assert not verify(),verify()
node='/opt/homebrew/bin/node'
chrome='/Users/me/Library/Caches/ms-playwright/chromium-1234/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing'
assert Path(chrome).is_file()
testfiles=sorted(p.relative_to(source).as_posix() for p in (source/'tests').glob('*.test.mjs'))
assert len(testfiles)==14 and 'tests/watch-file-report.test.mjs' in testfiles and 'tests/watch-report.test.mjs' in testfiles
command=[node,'--test','--test-concurrency=1','--test-reporter=tap',*testfiles]
env=dict(os.environ,LONGWATER_CHROME_PATH=chrome,TMPDIR=str(run/'tmp'),TZ='UTC')
env.pop('NODE_OPTIONS',None)
runtime={'node':subprocess.check_output([node,'--version'],text=True).strip(),'chrome':subprocess.check_output([chrome,'--version'],text=True).strip(),'playwright':json.loads((source/'node_modules/playwright/package.json').read_text())['version'],'dependency_resolution':str((source/'node_modules').resolve()),'no_install':True}
(run/'runtime.json').write_text(json.dumps(runtime,indent=2)+'\n')
started=datetime.datetime.now(datetime.timezone.utc).isoformat();start=time.monotonic()
timeout=False
with (run/'native.log').open('wb') as log:
 proc=subprocess.Popen(command,cwd=source,env=env,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
 try:code=proc.wait(timeout=270)
 except subprocess.TimeoutExpired:
  timeout=True
  os.killpg(proc.pid,signal.SIGTERM)
  try:code=proc.wait(timeout=5)
  except subprocess.TimeoutExpired:
   os.killpg(proc.pid,signal.SIGKILL);code=proc.wait(timeout=5)
elapsed=time.monotonic()-start
log=(run/'native.log').read_bytes()
totals={}
for name in ['tests','suites','pass','fail','cancelled','skipped','todo']:
 matches=re.findall(r'^# '+name+r' (\d+)$',log.decode(errors='replace'),re.M)
 totals[name]=int(matches[-1]) if matches else None
source_errors=verify()
artifacts=[]
for p in sorted((source/'test-results').glob('watch-file-report-*')):
 if p.is_file():
  b=p.read_bytes();artifacts.append({'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})
r={'started_at':started,'finished_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'elapsed_seconds':elapsed,'command':command,'cwd':str(source),'environment_overrides':{k:env[k] for k in ('LONGWATER_CHROME_PATH','TMPDIR','TZ')},'runtime':runtime,'returncode':code,'timed_out':timeout,'source_head':freeze['head'],'source_tree':freeze['tree'],'source_leaves':len(manifest),'source_manifest_sha256':freeze['manifest_sha256'],'source_verification_errors':source_errors,'all_source_bytes_modes_unchanged':not source_errors,'log_bytes':len(log),'log_sha256':hashlib.sha256(log).hexdigest(),'totals':totals,'file_report_artifacts':artifacts,'tests_expected':92,'scope':'One complete current native project suite after report/file composition and a concrete targeted callback correction; fourteen project-native test modules.'}
(run/'native-result.json').write_text(json.dumps(r,indent=2)+'\n')
print(json.dumps(r),flush=True)
if code or timeout or source_errors or totals.get('tests')!=92 or totals.get('pass')!=92 or any(totals.get(x)!=0 for x in ['fail','cancelled','skipped','todo']):
 sys.exit(1)
