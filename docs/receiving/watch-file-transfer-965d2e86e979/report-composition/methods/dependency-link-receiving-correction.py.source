import os,json,hashlib,subprocess,datetime
from pathlib import Path
root=Path('/Users/me/hamon-longwater-watch-file-r6-965d2e86e979');s=root/'source'
def g(*a):return subprocess.check_output(['git','--no-optional-locks','-C',str(s),*a],text=True)
failed=g('rev-parse','HEAD').strip()
failed_tree=g('rev-parse','HEAD^{tree}').strip()
node_entry=g('ls-tree','HEAD','node_modules').strip()
assert node_entry.startswith('120000 blob '),node_entry
subprocess.run(['git','-C',str(s),'update-ref','refs/receiving/unqualified-dependency-link',failed],check=True)
subprocess.run(['git','-C',str(s),'rm','--cached','node_modules'],capture_output=True,text=True,check=True)
exclude=s/'.git/info/exclude'
old=exclude.read_text() if exclude.exists() else ''
exclude.write_text(old+'\n# Owned native receiving outputs, never product source.\n/node_modules\n/test-results/\n/dist/\n')
tree=g('write-tree').strip()
env=dict(os.environ,GIT_AUTHOR_NAME='HAMON estate-965d2e86e979 receiving',GIT_AUTHOR_EMAIL='hamon-965d2e86e979@localhost',GIT_COMMITTER_NAME='HAMON estate-965d2e86e979 receiving',GIT_COMMITTER_EMAIL='hamon-965d2e86e979@localhost')
message='Compose watch-file transfer with landed printable watch reports\n\nSource receiving predecessor with unchanged R5 display-failure callback. Exact f321 common tree; preserve exposed R5 receipts and all incoming report source/evidence. The new file/report consumer test is staged, not yet executed.\n'
head=subprocess.check_output(['git','-C',str(s),'commit-tree',tree,'-p','88484be670a2418ef62c072a8dd8c0b77378f9b5','-p','8bfa11fc68e4c6c5a2bb9ea9dec41dab66173165'],input=message.encode(),env=env).decode().strip()
subprocess.run(['git','-C',str(s),'checkout','--detach',head],capture_output=True,text=True,check=True)
assert not g('status','--porcelain')
entries=[]
for item in subprocess.check_output(['git','-C',str(s),'ls-tree','-rz','HEAD']).split(b'\0'):
 if not item:continue
 meta,name=item.split(b'\t');mode,kind,blob=meta.decode().split();assert kind=='blob';rel=name.decode();p=s/rel
 assert mode in ('100644','100755'),(rel,mode)
 b=p.read_bytes()
 assert hashlib.sha1(b'blob '+str(len(b)).encode()+b'\0'+b).hexdigest()==blob
 assert ('100755' if p.stat().st_mode&0o111 else '100644')==mode
 entries.append({'path':rel,'mode':mode,'git_blob':blob,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})
assert len(entries)==162,len(entries)
manifest=(json.dumps(entries,indent=2)+'\n').encode();(root/'prefixed-source-manifest.json').write_bytes(manifest)
correction={'failed_recording_commit':failed,'failed_recording_tree':failed_tree,'unintended_entry':node_entry,'preserved_ref':'refs/receiving/unqualified-dependency-link','failure':'Manifest receiver refused a dependency symlink as a directory before native tests. No other-owner dependency bytes were copied or changed.','correction':'Remove only the unintentionally indexed owned link; keep its read-only native resolution untracked via local excludes. Product/test/artifact bytes are unchanged. Recreate the intended source merge with both exact source parents.','tests_executed':False}
(root/'prefixed-receiver-correction.json').write_text(json.dumps(correction,indent=2)+'\n')
receipt={'created_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'source':str(s),'head':head,'tree':tree,'leaves':len(entries),'manifest_sha256':hashlib.sha256(manifest).hexdigest(),'game_sha256':hashlib.sha256((s/'game.js').read_bytes()).hexdigest(),'game_exact_R5':g('show','88484be670a2418ef62c072a8dd8c0b77378f9b5:game.js')==(s/'game.js').read_text(),'artifact':json.loads((root/'prefixed-artifact.json').read_text()),'tests_executed':False,'receiver_correction':correction}
(root/'prefixed-source.json').write_text(json.dumps(receipt,indent=2)+'\n')
print(json.dumps(receipt))
