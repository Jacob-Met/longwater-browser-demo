import assert from "node:assert/strict";
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { pathToFileURL } from "node:url";
const [source, manifestPath, out] = process.argv.slice(2);
if (!source || !manifestPath || !out) throw Error("source, exact manifest and output required");
if (fs.existsSync(out)) throw Error("output already exists");
const space = fs.statfsSync(path.dirname(out));
if (space.bavail * space.bsize < 30000000) throw Error("insufficient space before fixture");
fs.mkdirSync(out);
const digest = b => crypto.createHash("sha256").update(b).digest("hex");
const manifestBytes = fs.readFileSync(manifestPath), manifest = JSON.parse(manifestBytes);
const checks = [], pageErrors = [], requests = [];
const receipt = { fixture: "one-shot authored post-adoption replayHistory refusal; actual browser, native WASM and file chooser",
  source, nativeInput: manifest.nativeInput, tree: manifest.tree, manifestSha256: digest(manifestBytes),
  harnessSha256: digest(fs.readFileSync(new URL(import.meta.url))), runtime: { node: process.version, platform: process.platform, arch: process.arch },
  started: new Date().toISOString(), checks, pageErrors, requests };
function check(name, actual, expected) {
  const pass = JSON.stringify(actual) === JSON.stringify(expected);
  checks.push({ name, actual, expected, pass });
  return pass;
}
function custody() {
  for (const entry of manifest.files) {
    const p = path.join(source, entry.path), b = fs.readFileSync(p);
    assert.equal(digest(b), entry.sha256, entry.path);
    const mode = (fs.statSync(p).mode & 0o111) ? "100755" : "100644";
    assert.equal(mode, entry.mode, entry.path + " mode");
  }
  return { files: manifest.files.length, allBytesAndModesMatch: true };
}
function fileRecord(name, data) {
  const b = Buffer.isBuffer(data) ? data : Buffer.from(data);
  fs.writeFileSync(path.join(out, name), b);
  return { name, bytes: b.length, sha256: digest(b) };
}
receipt.before = custody();
let browser, context, server;
try {
  const { initSync, BrowserSession } = await import(pathToFileURL(path.join(source, "pkg/longwater_web.js")).href);
  const { SIMULATION_REVISION, WATCH_SAVE_KEY } = await import(pathToFileURL(path.join(source, "watch-save.js")).href);
  const { createWatchReport } = await import(pathToFileURL(path.join(source, "watch-report.js")).href);
  const wasm = fs.readFileSync(path.join(source, "pkg/longwater_web_bg.wasm"));
  initSync({ module: wasm });
  receipt.nativeWasmSha256 = digest(wasm);
  const native = new BrowserSession(), turns = [], snapshots = [native.snapshot_json()];
  let raw;
  try {
    for (let index = 0; index < 5; index++) {
      const state = JSON.parse(native.snapshot_json());
      const cell = state.cells.find(c => c.shade < 3);
      assert.ok(cell, "five legal native shade decisions");
      snapshots.push(native.take_turn("shade", cell.id));
      turns.push({ action: "shade", cell: cell.id });
    }
    raw = JSON.stringify({ version: 1, simulation: SIMULATION_REVISION, turns, selected: "south", snapshot: native.snapshot_json() });
  } finally { native.free(); }
  receipt.input = fileRecord("incoming-day-5.json", raw);
  receipt.nativeSnapshots = fileRecord("incoming-native-snapshots.json", JSON.stringify(snapshots, null, 2) + "\n");
  check("native input is five accepted tides", JSON.parse(JSON.parse(raw).snapshot).day, 5);
  const expectedFresh = createWatchReport(snapshots.map(s => JSON.parse(s)));
  const { serve } = await import(pathToFileURL(path.join(source, "tests/server.mjs")).href);
  server = await serve();
  const { chromium } = await import("/Users/me/hamon-work-longwater-delivery-c945953fdeb7/node_modules/playwright/index.mjs");
  browser = await chromium.launch({ headless: true, executablePath: "/Users/me/Library/Caches/ms-playwright/chromium_headless_shell-1234/chrome-headless-shell-mac-arm64/chrome-headless-shell" });
  receipt.runtime.browserVersion = browser.version();
  context = await browser.newContext({ acceptDownloads: true, viewport: { width: 1280, height: 960 } });
  context.on("request", r => requests.push({ method: r.method(), url: r.url() }));
  const page = await context.newPage();
  page.setDefaultTimeout(7000);
  page.on("pageerror", e => pageErrors.push(e.message));
  const ready = async () => {
    await page.waitForFunction(() => !document.querySelector("#watch-file-open")?.disabled);
    assert.equal(await page.locator("#startup-error").isVisible(), false);
  };
  const report = page.locator("#watch-report-download");
  async function download(selector, filename) {
    const pending = page.waitForEvent("download");
    await page.locator(selector).click();
    const d = await pending, stream = await d.createReadStream(), chunks = [];
    for await (const chunk of stream) chunks.push(chunk);
    const data = Buffer.concat(chunks);
    return { suggestedFilename: d.suggestedFilename(), ...fileRecord(filename, data), raw: data.toString("utf8") };
  }
  await page.goto(server.url);
  await ready();
  await page.locator('[data-cell="1"]').click();
  await page.locator('[data-action="gate"]').click();
  await page.locator('[data-cell="2"]').click();
  await page.locator('[data-action="shade"]').click();
  const oldRaw = await page.evaluate(key => localStorage.getItem(key), WATCH_SAVE_KEY);
  receipt.oldWatch = fileRecord("previous-day-2.json", oldRaw);
  check("actual prior page is day 2", JSON.parse(JSON.parse(oldRaw).snapshot).day, 2);
  check("prior report is visible and enabled", [await report.isVisible(), await report.isEnabled()], [true, true]);
  const oldReport = await download("#watch-report-download", "previous-report.html");
  receipt.priorReport = { ...oldReport }; delete receipt.priorReport.raw;
  check("actual previous report describes tide 2", [oldReport.suggestedFilename, oldReport.raw.includes("Partial watch · 2 of 14 tides completed")], ["Longwater-watch-tide-02.html", true]);
  const selected = page.waitForEvent("filechooser");
  await page.locator("#watch-file-open").click();
  await (await selected).setFiles({ name: "independent-day-5.json", mimeType: "application/json", buffer: Buffer.from(raw) });
  await page.locator("#watch-file-preview").waitFor({ state: "visible" });
  check("review does not write the imported watch", await page.evaluate(key => localStorage.getItem(key), WATCH_SAVE_KEY), oldRaw);
  await page.evaluate(async () => {
    const { SavedWatch } = await import("/watch-save.js");
    const original = SavedWatch.prototype.replayHistory;
    SavedWatch.prototype.replayHistory = function () {
      SavedWatch.prototype.replayHistory = original;
      window.peerReplayFault = { activeDay: JSON.parse(this.snapshot).day, exported: this.exportFile(), calls: 1 };
      throw new Error("Independent authored post-adoption replayHistory refusal");
    };
  });
  await page.locator("#watch-file-confirm").click();
  await page.locator("#watch-file-preview").waitFor({ state: "hidden" });
  const fault = await page.evaluate(() => window.peerReplayFault);
  receipt.fault = { activeDay: fault?.activeDay, calls: fault?.calls, exportedSha256: fault?.exported ? digest(fault.exported) : null };
  check("injection happened once after native adoption", [fault?.activeDay, fault?.calls, fault?.exported === raw], [5, 1, true]);
  const status = await page.locator("#watch-file-status").textContent();
  receipt.postAdoptionStatus = status;
  check("status identifies adopted day and refresh failure", [/Opened day 5/.test(status), /display could not be refreshed/.test(status), /saved in this browser/.test(status)], [true, true, true]);
  check("stale game controls refuse input", await page.locator(".game-control:disabled").count(), 7);
  const visibility = { journal: await page.locator("#watch-journal").isVisible(), report: await report.isVisible(), buttonEnabled: await report.isEnabled() };
  receipt.postAdoptionVisibility = visibility;
  check("stale journal and downloadable report are hidden after adoption failure", [visibility.journal, visibility.report], [false, false]);
  if (visibility.report && visibility.buttonEnabled) {
    const stale = await download("#watch-report-download", "stale-report-after-day-5-adoption.html");
    receipt.staleReport = { ...stale }; delete receipt.staleReport.raw;
    check("visible report counterexample is exactly the previous day 2 HTML", [stale.raw === oldReport.raw, stale.suggestedFilename], [true, "Longwater-watch-tide-02.html"]);
  }
  const active = await download("#watch-file-download", "active-watch-after-fault.json");
  receipt.activeDownload = { ...active }; delete receipt.activeDownload.raw;
  check("actual watch download retains exact adopted day 5 file", [active.raw === raw, active.suggestedFilename], [true, "Longwater-watch-day-5.json"]);
  check("browser persistence retains exact adopted input", await page.evaluate(key => localStorage.getItem(key), WATCH_SAVE_KEY), raw);
  await page.reload();
  await ready();
  check("reload opens the adopted watch and complete history", [await page.locator("#journal-entries > li").count(), /Day 5/.test(await page.locator("#state-summary").textContent())], [5, true]);
  check("fresh restored journal and report are accessible", [await page.locator("#watch-journal").isVisible(), await report.isVisible(), await report.isEnabled()], [true, true, true]);
  const fresh = await download("#watch-report-download", "restored-day-5-report.html");
  receipt.restoredReport = { ...fresh }; delete receipt.restoredReport.raw;
  check("restored actual report equals all six native snapshots", [fresh.raw === expectedFresh.html, fresh.suggestedFilename, fresh.raw.includes("Partial watch · 5 of 14 tides completed")], [true, "Longwater-watch-tide-05.html", true]);
  check("download does not change adopted watch", await page.evaluate(key => localStorage.getItem(key), WATCH_SAVE_KEY), raw);
  check("no uncaught browser error", pageErrors, []);
  check("all page requests use exact local source", requests.filter(r => !r.url.startsWith(server.url + "/") && !/^(data|blob):/.test(r.url)), []);
} catch (error) {
  receipt.executionError = { name: error.name, message: error.message, stack: error.stack };
} finally {
  try { await context?.close(); await browser?.close(); await server?.close(); receipt.childrenClosed = true; } catch (e) { receipt.cleanupError = String(e); }
  try { receipt.after = custody(); } catch (e) { receipt.sourceError = String(e); }
  receipt.finished = new Date().toISOString();
  receipt.passed = checks.filter(c => c.pass).length;
  receipt.failed = checks.filter(c => !c.pass).length;
  receipt.accepted = !receipt.executionError && !receipt.sourceError && !receipt.cleanupError && receipt.failed === 0;
  fs.writeFileSync(path.join(out, "result.json"), JSON.stringify(receipt, null, 2) + "\n");
  console.log(JSON.stringify({ accepted: receipt.accepted, passed: receipt.passed, failed: receipt.failed,
    failingChecks: checks.filter(c => !c.pass).map(c => c.name), error: receipt.executionError,
    resultSha256: digest(fs.readFileSync(path.join(out, "result.json"))), childrenClosed: receipt.childrenClosed }));
  process.exitCode = receipt.accepted ? 0 : 1;
}
