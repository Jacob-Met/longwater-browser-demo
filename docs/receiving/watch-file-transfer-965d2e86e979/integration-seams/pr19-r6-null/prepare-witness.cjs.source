for(const mode of["negative","positive"]){
 const out=p+"/"+mode+"-witness";assert.ok(!fs.existsSync(out));fs.mkdirSync(out);
 fs.writeFileSync(out+"/receive-adoption-seam.mjs",adapted);
 fs.writeFileSync(out+"/incoming-pr19.json",JSON.stringify({...inputBase,nullInvalidation:mode==="positive",composedPin:composition[mode].commit,composedTree:composition[mode].tree},null,2)+"\n");
}
const receipt={format:"hamon-bounded-witness-fixture-adapter/1",originalHarnessSha256:sha(Buffer.from(original)),adaptedHarnessSha256:sha(Buffer.from(adapted)),sameAdaptedBytesInBothRuns:true,threeCaseBodySha256:sha(Buffer.from(cases)),caseBytes:Buffer.byteLength(cases),allThreeBehavioralCaseBodiesAndAssertionsByteExact:true,completeOriginalRecoveredByInverse:true,changes,sourceScope:"Only fixture source/commit/tree bindings, two required current report routes, exact frozen composition binding and recorded provenance. Original composition functions, three cases and all behavioral assertions remain byte-exact.",browserRuntimeUnchanged:chrome};
