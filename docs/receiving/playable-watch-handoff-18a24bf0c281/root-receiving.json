    "full_body": "name: smoke\n\non:\n  push:\n    branches: [longwater-demo]\n  pull_request:\n    branches: [longwater-demo]\n\n# A bad push here breaks the live demo for visitors, so keep this cheap and\n# fast: syntax-check the UI script and confirm every asset the page loads\n# actually exists and is non-empty.\njobs:\n  smoke:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - name: JS syntax check\n        run: node --check game.js\n      - name: Referenced assets exist and are non-empty\n        run: |\n          set -e\n          # .nojekyll is legitimately empty; everything else must be non-empty.\n          test -e .nojekyll || { echo \"missing: .nojekyll\"; exit 1; }\n          for f in index.html style.css game.js journal.js journal.css watch-save.js watch-save.css \\\n                   pkg/longwater_web.js pkg/longwater_web.d.ts \\\n                   pkg/longwater_web_bg.wasm pkg/longwater_web_bg.wasm.d.ts; do\n            test -s \"$f\" || { echo \"missing or empty: $f\"; exit 1; }\n          done\n          grep -q '\\./pkg/longwater_web.js' game.js\n          grep -q '\\./game.js' index.html\n          grep -q '\\./style.css' index.html\n          echo \"smoke OK\"\n\n  browser:\n    runs-on: ubuntu-latest\n    timeout-minutes: 8\n    steps:\n      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4\n      - name: Install browser test dependencies\n        run: npm ci\n      - name: Install Chromium\n        run: npx playwright install --with-deps chromium\n      - name: Play and resume the real WASM watch, including offline packaging\n        run: npm test\n      - name: Receive the original historical-choice file-adoption witness\n        run: node scripts/receive-watch-choice-adoption.mjs\n      - name: Emit the bounded authored historical-choice captures\n        if: always()\n        run: node scripts/emit-watch-choice-artifacts.mjs\n      - name: Preserve historical-choice receiving artifacts\n        if: always()\n        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4\n        with:\n          name: historical-choice-${{ github.sha }}\n          path: test-results/watch-choice\n          if-no-files-found: warn\n          retention-days: 14\n",
